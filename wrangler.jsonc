// Cloudflare Worker that serves the Flutter web build (static assets only, no server code).
// Deployed by .github/workflows/deploy-web.yml after `flutter build web`.
{
  "name": "storefront-workforce",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  }
}
